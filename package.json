{
  "name": "sanad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @sanad/web build",
    "check:course-agnostic": "bash scripts/check-course-agnostic.sh",
    "check:db": "tsx scripts/check-db.ts",
    "db:generate": "pnpm --filter @sanad/db generate",
    "db:migrate": "pnpm --filter @sanad/db migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "demo:reset": "bash scripts/reset-demo.sh",
    "dev": "pnpm --filter @sanad/web dev",
    "mobile": "pnpm --filter @sanad/mobile start",
    "setup": "bash scripts/setup.sh",
    "setup:docker": "bash scripts/setup.sh --docker",
    "test": "vitest run",
    "test:asr": "cd benchmarks/asr && python3 -m unittest discover -p \"test_*.py\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:all": "bash scripts/verify-all.sh",
    "verify:isolation": "tsx scripts/verify-isolation.ts",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "playwright-core": "^1.62.1",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "uuid": "^11.0.5",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "fflate": "^0.8.3",
    "unpdf": "^1.8.1"
  }
}
