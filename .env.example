# Copy to .env and adjust. Never commit .env.
NODE_ENV=development

# PostgreSQL (pgvector extension required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sanad_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sanad_test

# Session cookie signing / app secret. Generate: openssl rand -base64 32
APP_SECRET=change-me-at-least-32-characters-long-value

# Session lifetime (days)
SESSION_TTL_DAYS=30

# Default interface language for new accounts (BCP-47)
DEFAULT_LOCALE=en

